# ---------------------------------------------------------------------------
# Environments (DEV / UAT / PROD)
# ---------------------------------------------------------------------------
# The web app talks to one backend, chosen by API_URL:
#   DEV  — your machine's backend. Local only; Amplify's compute cannot reach
#          localhost, so this value never deploys.
#   UAT  — the pre-release backend on AWS Lambda (Singapore).
#   PROD — the live backend.
#
# Local development picks one of these with the env/ files + start script:
#   npm run dev        # DEV
#   npm run dev:uat    # UAT
#   npm run dev:prod   # PROD
# Deployed environments read API_URL from the Amplify console per branch (see
# infra/), which amplify.yml copies into .env.production at build time.
#
# ---------------------------------------------------------------------------
# The MeowQuest API
# ---------------------------------------------------------------------------
# Where the MeowQuest API lives. Read on the server only — the browser talks to
# this app's own /api/* routes, which forward the request, so the API's origin
# is never exposed to the page and there is no CORS to configure.
#
#   DEV:  http://localhost:3000
#   UAT:  https://sihm6r0gsc.execute-api.ap-southeast-1.amazonaws.com
#   PROD: https://api.meowquest.app
API_URL="http://localhost:3000"

# Deep link back into the mobile app from the "verified!" screen. Must match the
# scheme in frontend/app.json.
NEXT_PUBLIC_APP_SCHEME="meowquest://"
